# Genvy server configuration — copy to .env in the repo root and fill in what you have.
# Every provider is optional (BYO keys): missing keys simply render that provider
# LINK OFFLINE in the HUD. The .env file is gitignored; never commit real keys.

# --- Core (used today) ---------------------------------------------------------
# DeepSeek — concepts, layouts, prompt sanitizing (text/JSON).
DEEPSEEK_API_KEY=""
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL="deepseek-chat"

# OpenAI — image generation/edits. Always gpt-image-2 (never gpt-image-1).
OPENAI_API_KEY=""
# OPENAI_IMAGE_MODEL="gpt-image-2"

# Server
# PORT=3020
# LIBRARY_DIR="./library"

# --- Additional API providers (Sprite Pipeline v2, phase P1) -------------------
# Retro Diffusion — pixel-art styles up to 384px + animation endpoint
# (anchor frame + action -> transparent spritesheet).
# RETRODIFFUSION_API_KEY=""

# PixelLab — skeleton-based animation & 4/8-direction rotation (<=128px tier).
# PIXELLAB_API_KEY=""

# --- Local inference service (Sprite Pipeline v2, phase P6) --------------------
# The genvy local-inference service (npm run dev:local) wraps ComfyUI behind a
# job queue and registers as the free "Local ComfyUI" provider. The app runs
# unchanged when it is down — the provider just shows OFFLINE.
# LOCAL_INFERENCE_URL="http://127.0.0.1:3021"

# Read by the local-inference service itself (see local-inference/README.md):
# COMFYUI_URL="http://127.0.0.1:8188"
# MODEL_FAMILY="sdxl"            # sdxl | z-image-turbo | hidream-o1 | flux2 (see README family matrix)
# COMFY_CHECKPOINT=""            # empty = the family's default checkpoint.
#   Small-VRAM cards: point at a .gguf quant (e.g. "z_image_turbo_q4.gguf",
#   needs the ComfyUI-GGUF node pack) — the loader swaps automatically and
#   warm renders run ~2x faster because the model fits on-GPU.
# COMFY_RENDER_SIZE=768          # drop to 640 on 8GB GPUs (512 on 4GB)
# REMBG_PYTHON=""                # python with rembg installed -> segmentation cutouts
# LOCAL_INFERENCE_PORT=3021
